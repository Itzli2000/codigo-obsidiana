---
import { getLangFromUrl } from "../../i18n/utils";
import type { Lang } from "../../types/language";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const lang = getLangFromUrl(Astro.url) as Lang;

const labels = {
  es: { toDark: "Cambiar a tema oscuro", toLight: "Cambiar a tema claro" },
  en: { toDark: "Switch to dark theme", toLight: "Switch to light theme" },
}[lang] ?? { toDark: "Switch to dark theme", toLight: "Switch to light theme" };
---

{/*
  Two-state color scheme toggle (system default vs. explicit override).
  The rendered scheme comes from <meta name="color-scheme"> (set in MainLayout's
  inline head script) plus the system preference, so the icon is right on first
  paint. Only one of the two options is displayed at a time.
*/}
<button type="button" class:list={["theme-switcher", className]} data-theme-toggle>
  {/* shown while the page renders light: sun icon, action switches to dark */}
  <span class="ts-option ts-light">
    <svg class="h-6 w-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
      ></path>
    </svg>
    <span class="sr-only">{labels.toDark}</span>
  </span>

  {/* shown while the page renders dark: moon icon, action switches to light */}
  <span class="ts-option ts-dark">
    <svg class="h-6 w-6 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"
      ></path>
    </svg>
    <span class="sr-only">{labels.toLight}</span>
  </span>
</button>

<style>
  .theme-switcher {
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .theme-switcher:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .ts-option {
    display: inline-grid;
    place-items: center;
  }

  /* Default: light rendering */
  .ts-dark {
    display: none;
  }

  /* Explicit dark override */
  :global(:root:has(> head > meta[name="color-scheme"][content="dark"])) .ts-light {
    display: none;
  }
  :global(:root:has(> head > meta[name="color-scheme"][content="dark"])) .ts-dark {
    display: inline-grid;
  }

  /* System is dark and there is no explicit light override */
  @media (prefers-color-scheme: dark) {
    :global(:root:not(:has(> head > meta[name="color-scheme"][content="light"]))) .ts-light {
      display: none;
    }
    :global(:root:not(:has(> head > meta[name="color-scheme"][content="light"]))) .ts-dark {
      display: inline-grid;
    }
  }
</style>

<script>
  const STORAGE_KEY = "color-scheme";
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  type Scheme = "light" | "dark";

  const readStored = (): Scheme | null => {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };

  const writeStored = (value: Scheme | null) => {
    try {
      if (value) localStorage.setItem(STORAGE_KEY, value);
      else localStorage.removeItem(STORAGE_KEY);
    } catch {
      // Storage blocked: the override still applies for this page view.
    }
  };

  // Kept in memory so the toggle works even when storage is unavailable.
  let override = readStored();

  const apply = () => {
    if (meta) meta.content = override ?? "light dark";
    const dark = override ? override === "dark" : systemDark.matches;
    document.documentElement.dataset.theme = dark ? "obsidiana-dark" : "obsidiana-light";
  };

  // Drop the value written by the previous toggle implementation.
  try {
    localStorage.removeItem("theme");
  } catch {}

  apply();

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const renderedDark = override ? override === "dark" : systemDark.matches;
      const target: Scheme = renderedDark ? "light" : "dark";
      const system: Scheme = systemDark.matches ? "dark" : "light";
      // Matching the system preference means undoing the override, not pinning it.
      override = target === system ? null : target;
      writeStored(override);
      apply();
    });
  });

  // Only re-render on system changes; never touch the stored override here.
  systemDark.addEventListener("change", apply);

  window.addEventListener("storage", (event) => {
    if (event.key === STORAGE_KEY || event.key === null) {
      override = readStored();
      apply();
    }
  });
</script>
