---
import { getLangFromUrl } from "../../i18n/utils";
import type { Lang } from "../../types/language";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const lang = getLangFromUrl(Astro.url) as Lang;

// Get current path and calculate other language path
const otherLang: Lang = lang === "en" ? "es" : "en";
// Starts with the visible text so voice-control users can say what they see (WCAG 2.5.3)
const otherLangLabel = otherLang === "en" ? "EN – Read in English" : "ES – Leer en español";

const currentPath = Astro.url.pathname;
let otherLangPath = currentPath.replace(
  new RegExp(`^/${lang}`), 
  `/${lang === "en" ? "es" : "en"}`
);

// Paths without a language prefix (e.g. the 404 page) fall back to the other language's home
if (otherLangPath === currentPath) {
  otherLangPath = `/${lang === "en" ? "es" : "en"}`;
}
---

<a
  href={otherLangPath}
  hreflang={otherLang}
  lang={otherLang}
  class:list={["language-switcher btn btn-sm btn-ghost font-medium", className]}
  aria-label={otherLangLabel}
>
  {otherLang.toUpperCase()}
</a>

<style>
  .btn-ghost {
    text-transform: uppercase;
    font-family: var(--font-body);
    letter-spacing: 0.05em;
    transition: all var(--theme-transition-duration) var(--theme-transition-timing);
  }

  @media (max-width: 767.98px) {
    .btn-ghost { min-height: 44px; min-width: 44px; }
  }

  .btn-ghost:hover {
    background-color: var(--color-base-200);
    color: var(--color-accent-text);
  }
</style> 