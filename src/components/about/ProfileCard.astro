---
import { NETWORK } from "../../constants/network";

interface Props {
  role: string;
  tagline: string;
  description: string;
  lang?: string;
}

const { role, tagline, description, lang = "es" } = Astro.props;

// The Blob serves the PDF inline; ?download=1 makes it respond as an attachment.
const resumeDownloadUrl = `${NETWORK.RESUME}?download=1`;
---

<section class="profile-hero">
  <div class="profile-inner">
    <!-- Left: copy -->
    <div class="profile-copy">
      <div class="eyebrow" style="margin-bottom: 24px;">
        {lang === "es" ? "Sobre mí" : "About me"}
      </div>

      <h1 class="profile-name">
        Ariel Itzli
        <em class="name-accent">Molina</em>
        Sánchez
      </h1>

      <p class="profile-tagline">{tagline}</p>
      <p class="profile-desc">{description}</p>

      <div class="profile-ctas">
        <a href={resumeDownloadUrl} download class="profile-btn-primary">
          {lang === "es" ? "Descargar CV" : "Download CV"}
          <span aria-hidden="true">↓</span>
        </a>
        <a href={NETWORK.LINKEDIN} target="_blank" rel="noopener" class="profile-btn-ghost">
          LinkedIn
        </a>
        <a href={NETWORK.GITHUB} target="_blank" rel="noopener" class="profile-btn-ghost">
          GitHub
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .profile-hero {
    /* --color-muted (var(--color-muted), 4.77:1) in light; dark keeps solid base-content because the dark
       --color-muted is 55% alpha (3.0:1). Small orange text is darkened to clear 4.5:1
       (accent #f0623f is 3.03:1). */
    --ink-muted: var(--color-muted);
    --ink-soft: light-dark(#3d4146, var(--color-base-content));
    --ink-accent: var(--color-accent-text);

    padding: 100px 48px 60px;
    border-bottom: 1px solid var(--color-base-300);
  }

  .profile-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .profile-copy {
    display: flex;
    flex-direction: column;
  }

  .profile-name {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 80px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0 0 24px;
    color: var(--color-base-content);
    text-wrap: pretty;
  }

  .name-accent {
    font-style: italic;
    font-weight: 300;
    /* Large text only: accent #f0623f is 3.03:1 on light base-100 */
    color: var(--color-accent-text);
  }

  .profile-tagline {
    font-family: var(--font-display);
    font-size: 20px;
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 560px;
    margin: 0 0 20px;
    font-weight: 400;
    text-wrap: pretty;
  }

  .profile-desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-muted);
    max-width: 560px;
    margin: 0 0 32px;
  }

  .profile-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .profile-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 4px;
    font-weight: 500;
    font-size: 14px;
    background: var(--color-accent);
    /* Dark ink on orange from the accent-content token */
    color: var(--color-accent-content);
    border: 1px solid transparent;
    text-decoration: none;
    font-family: var(--font-body);
    transition: color 0.2s, background-color 0.2s, border-color 0.2s, opacity 0.2s, transform 0.2s, filter 0.2s;
  }

  .profile-btn-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .profile-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 4px;
    font-weight: 500;
    font-size: 14px;
    background: transparent;
    color: var(--color-base-content);
    border: 1px solid var(--color-base-300);
    text-decoration: none;
    font-family: var(--font-body);
    transition: color 0.2s, background-color 0.2s, border-color 0.2s, opacity 0.2s, transform 0.2s, filter 0.2s;
  }

  .profile-btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--ink-accent);
  }

  @media (max-width: 900px) {
    .profile-hero { padding: 60px 24px 40px; }
  }

  /* Global .eyebrow fades with opacity; use a solid muted color instead */
  .profile-hero .eyebrow {
    color: var(--ink-muted);
    opacity: 1;
  }
</style>
