---
import experiencesEn from "../../i18n/languages/experiences/en.json";
import experiencesEs from "../../i18n/languages/experiences/es.json";

interface Experience {
  role: string;
  company: string;
  period: string;
  description: string;
  technologies: string[];
  achievements: string[];
}

interface Props {
  title: string;
  lang?: "en" | "es";
}

const { title, lang = "en" } = Astro.props;

const experiences: Experience[] =
  lang === "en" ? experiencesEn.experiences : experiencesEs.experiences;

/** Roles shown in full; older ones collapse into one-line disclosures. */
const RECENT_COUNT = 4;
const recent = experiences.slice(0, RECENT_COUNT);
const earlier = experiences.slice(RECENT_COUNT);
const techLabel = lang === "es" ? "Tecnologías" : "Technologies";
---

<section class="experience-section" aria-labelledby="experience-title">
  <div class="experience-inner">
    <!-- Section header -->
    <div class="experience-header">
      <div class="eyebrow" style="margin-bottom: 12px;">
        {lang === "es" ? "02 · Experiencia" : "02 · Experience"}
      </div>
      <h2 class="experience-title" id="experience-title">
        {lang === "es"
          ? <>{`Dónde he `}<em>{`construido`}</em></>
          : <>{`Where I've `}<em>{`built`}</em></>}
      </h2>
    </div>

    <!-- Recent roles, in full -->
    <div class="experience-list">
      {recent.map((exp) => (
        <article class="exp-row">
          <div class="exp-period">{exp.period}</div>
          <div class="exp-content">
            <h3 class="exp-role">{exp.role}</h3>
            <div class="exp-company">@ {exp.company}</div>
            <p class="exp-desc">{exp.description}</p>
            <ul class="exp-achievements">
              {exp.achievements.map((ach) => (
                <li class="exp-achievement">{ach}</li>
              ))}
            </ul>
            <ul class="exp-tech" aria-label={techLabel}>
              {exp.technologies.map((tech) => (
                <li class="exp-tech-badge">{tech}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- Earlier roles: one line each, expandable -->
    {earlier.length > 0 && (
      <div class="exp-earlier" role="group" aria-labelledby="exp-earlier-title">
        <h3 class="exp-earlier-title" id="exp-earlier-title">
          {lang === "es" ? "Experiencia anterior" : "Earlier roles"}
        </h3>
        {earlier.map((exp) => (
          <details class="exp-item">
            <summary class="exp-summary">
              <span class="exp-summary-period">{exp.period}</span>
              <span class="exp-summary-main">
                <span class="exp-summary-role">{exp.role}</span>
                <span class="exp-summary-company">@ {exp.company}</span>
              </span>
            </summary>
            <div class="exp-detail">
              <p class="exp-desc">{exp.description}</p>
              <ul class="exp-achievements">
                {exp.achievements.map((ach) => (
                  <li class="exp-achievement">{ach}</li>
                ))}
              </ul>
              <ul class="exp-tech" aria-label={techLabel}>
                {exp.technologies.map((tech) => (
                  <li class="exp-tech-badge">{tech}</li>
                ))}
              </ul>
            </div>
          </details>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .experience-section {
    /*
     * Text colors for this base-200 surface. Light: #6b6f74 is 4.37:1 here, so
     * labels use one step darker (4.77:1, the same ratio #6b6f74 gets on base-100).
     * Small orange text uses a deeper/lighter orange so it clears 4.5:1 in each theme.
     */
    --exp-ink-muted: light-dark(#65696e, var(--color-base-content));
    --exp-ink-soft: light-dark(#3d4146, var(--color-base-content));
    --exp-ink-accent: light-dark(oklch(54% 0.16 35), oklch(74% 0.14 38));

    padding: 100px 48px;
    background: var(--color-base-200);
    border-top: 1px solid var(--color-base-300);
    border-bottom: 1px solid var(--color-base-300);
  }

  .experience-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .experience-header {
    margin-bottom: 60px;
  }

  .experience-header .eyebrow {
    color: var(--exp-ink-muted);
    opacity: 1;
  }

  .experience-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-base-content);
  }

  .experience-title em {
    font-style: italic;
    font-weight: 300;
  }

  /* Timeline rows */
  .experience-list {
    display: flex;
    flex-direction: column;
  }

  .exp-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 48px;
    padding: 40px 0;
    border-top: 1px solid var(--color-base-300);
  }

  .exp-period,
  .exp-summary-period {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--exp-ink-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .exp-period {
    padding-top: 4px;
  }

  .exp-role {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    color: var(--color-base-content);
  }

  .exp-company,
  .exp-summary-company {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--exp-ink-accent);
    letter-spacing: 0.08em;
  }

  .exp-company {
    margin-bottom: 16px;
  }

  .exp-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--exp-ink-muted);
    margin: 0 0 18px;
    max-width: 640px;
  }

  .exp-achievements {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: grid;
    gap: 8px;
  }

  .exp-achievement {
    font-size: 14px;
    line-height: 1.6;
    color: var(--exp-ink-soft);
    padding-left: 20px;
    position: relative;
  }

  .exp-achievement::before {
    content: "▹";
    position: absolute;
    left: 0;
    top: 1px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .exp-tech {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .exp-tech-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 10px;
    border: 1px solid var(--color-base-300);
    border-radius: 999px;
    color: var(--exp-ink-muted);
  }

  /* Earlier roles: native disclosures */
  .exp-earlier {
    border-top: 1px solid var(--color-base-300);
    padding-top: 40px;
  }

  .exp-earlier-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--exp-ink-muted);
    margin: 0 0 12px;
  }

  .exp-item {
    border-bottom: 1px solid var(--color-base-300);
  }

  .exp-summary {
    list-style: none;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 48px;
    align-items: baseline;
    padding: 18px 0;
    cursor: pointer;
    border-radius: 2px;
  }

  .exp-summary::-webkit-details-marker {
    display: none;
  }

  .exp-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .exp-summary-main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 14px;
    row-gap: 2px;
  }

  .exp-summary-role {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-base-content);
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }

  /* Chevron right before the label; points down when open */
  .exp-summary-role::before {
    content: "";
    inline-size: 0.5em;
    block-size: 0.5em;
    flex-shrink: 0;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    rotate: -45deg;
    translate: 0 -0.12em;
  }

  .exp-item[open] .exp-summary-role::before {
    rotate: 45deg;
    translate: 0 -0.25em;
  }

  .exp-summary:hover .exp-summary-role {
    color: var(--exp-ink-accent);
  }

  .exp-detail {
    margin-left: calc(200px + 48px);
    padding: 4px 0 32px;
  }

  details.exp-item::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }

  details.exp-item:not([open])::details-content {
    block-size: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .exp-summary-role::before {
      transition: rotate 0.2s, translate 0.2s;
    }

    details.exp-item::details-content {
      transition: block-size, content-visibility;
      transition-duration: 0.3s;
      transition-timing-function: ease-in-out;
      transition-behavior: allow-discrete;
    }
  }

  @media (forced-colors: active) {
    .exp-summary-role::before {
      border-color: CanvasText;
    }
  }

  @media (max-width: 900px) {
    .experience-section {
      padding: 60px 24px;
    }

    .exp-row,
    .exp-summary {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .exp-summary {
      gap: 6px;
    }

    .exp-detail {
      margin-left: 0;
    }
  }
</style>
