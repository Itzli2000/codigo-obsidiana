---
interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
---

<section class="edu-section">
  <div class="edu-inner">
    <div class="edu-label">
      <div class="eyebrow">
        {lang === "es" ? "04 · Educación" : "04 · Education"}
      </div>
    </div>

    <div class="edu-content">
      <h3 class="edu-degree">
        {lang === "es"
          ? "Ingeniería en Sistemas Computacionales"
          : "Computer Systems Engineering"}
      </h3>
      <div class="edu-meta">
        {lang === "es"
          ? "2022 — 2025 · Universidad Latinoamericana (ULA), CDMX"
          : "2022 — 2025 · Universidad Latinoamericana (ULA), CDMX"}
      </div>
      <p class="edu-desc">
        {lang === "es"
          ? "También cursé Ingeniería en Sistemas Computacionales en la Escuela Superior de Cómputo (ESCOM — IPN)."
          : "Also studied Computer Systems Engineering at Escuela Superior de Cómputo (ESCOM — IPN)."}
      </p>
    </div>
  </div>
</section>

<style>
  .edu-section {
    /* --color-muted (var(--color-muted), 4.77:1) in light; dark keeps solid base-content because the dark
       --color-muted is 55% alpha (3.0:1). Small orange text is darkened to clear 4.5:1
       (accent #f0623f is 3.03:1). */
    --ink-muted: var(--color-muted);
    --ink-soft: light-dark(#3d4146, var(--color-base-content));
    --ink-accent: var(--color-accent-text);

    padding: 80px 48px;
    border-top: 1px solid var(--color-base-300);
  }

  .edu-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
    align-items: start;
  }

  .edu-label {
    padding-top: 4px;
  }

  .edu-degree {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
    color: var(--color-base-content);
  }

  .edu-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }

  .edu-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-muted);
    margin: 0;
    max-width: 580px;
  }

  @media (max-width: 900px) {
    .edu-section {
      padding: 60px 24px;
    }

    .edu-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* Global .eyebrow fades with opacity; use a solid muted color instead */
  .edu-section .eyebrow {
    color: var(--ink-muted);
    opacity: 1;
  }
</style>
